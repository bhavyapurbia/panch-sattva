PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE

ADMIN_EMAIL=admin@panchsattva.com
ADMIN_PASSWORD=Admin@123

# Cloudinary Image Upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── YOUPI PG Payment Gateway ─────────────────────────────────
# Base URL of the YOUPI Payment Core API (local: http://localhost:6100)
YOUPI_API_URL=http://localhost:6100
# Merchant UUID from YOUPI Merchant Admin Panel (http://localhost:6001)
YOUPI_MERCHANT_ID=your-merchant-uuid-here
# Merchant API key (same as webhook_secret from YOUPI Merchant Admin)
YOUPI_MERCHANT_KEY=your_youpi_merchant_key_here
# Webhook secret for HMAC-SHA256 signature verification
YOUPI_WEBHOOK_SECRET=your_youpi_webhook_secret_here
# Frontend URL (used as returnUrl base for YOUPI checkout redirect)
CLIENT_URL=http://localhost:5173
